{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeepDive",
  "version": "0.1.0",
  "identifier": "com.deepdive.gui",
  "build": {
    "frontendDist": "ui/dist",
    "devUrl": "http://localhost:5180",
    "beforeDevCommand": "npm --prefix ui run dev",
    "beforeBuildCommand": "npm --prefix ui run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "DeepDive",
        "width": 980,
        "height": 720,
        "minWidth": 680,
        "minHeight": 480,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "DeveloperTool",
    "copyright": "© DeepDive",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ]
  }
}
